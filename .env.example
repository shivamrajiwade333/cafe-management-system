# ==============================================================================
# SMART CAFE ORDERING PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Supabase PostgreSQL & Realtime Configuration
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Supabase Service Role Key (Keep Private - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Application Public Domain (for Table QR Code generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Multi-Tenant Default Cafe ID
NEXT_PUBLIC_DEFAULT_CAFE_ID=cafe001
